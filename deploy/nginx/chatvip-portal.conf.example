# ChatVIP production example for BaoTa/Nginx.
# Keep the SSL certificate paths generated by BaoTa if they differ from these defaults.

server {
    listen 80;
    server_name chatvip.aittco.com;
    return 301 https://chatvip.aittco.com$request_uri;
}

server {
    listen 80;
    server_name chat.aittco.com;
    return 301 https://chat.aittco.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name chatvip.aittco.com;

    root /www/wwwroot/chatvip.aittco.com;
    index index.html;

    ssl_certificate /www/server/panel/vhost/cert/chatvip.aittco.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/chatvip.aittco.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 275m;

    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 60s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    location = /main {
        return 301 /main/;
    }

    # The trailing slash on proxy_pass is required: it strips /main/ before
    # forwarding the request to the classic service.
    location /main/ {
        proxy_pass http://127.0.0.1:3001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 60s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    location / {
        root /www/wwwroot/chatvip.aittco.com;
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    server_name chat.aittco.com;

    ssl_certificate /www/server/panel/vhost/cert/chat.aittco.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/chat.aittco.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 275m;

    location / {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 60s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }
}
