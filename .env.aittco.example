HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# Only the native Google/Anthropic endpoints and the two fixed custom endpoints.
ENDPOINTS=google,anthropic,custom

# Keep all built-in shared provider credentials disabled. Users enter keys in the Web UI.
OPENAI_API_KEY=
XAI_API_KEY=
ASSISTANTS_API_KEY=
AZURE_OPENAI_API_KEY=

# Gemini native protocol: /v1beta/models/{model}:generateContent
GOOGLE_KEY=user_provided
GOOGLE_MODELS=gemini-3.5-flash-preview,gemini-3.7-flash,gemini-3.8-flash,gemini-3.1-pro-preview
GOOGLE_REVERSE_PROXY=https://api.aittco.com

# Claude native protocol: /v1/messages
ANTHROPIC_API_KEY=user_provided
ANTHROPIC_MODELS=claude-opus-5,claude-sonnet-5,claude-opus-4-8
ANTHROPIC_REVERSE_PROXY=https://api.aittco.com

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false

# Replace each value before production startup.
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
CREDS_KEY=replace-with-openssl-rand-hex-32
CREDS_IV=replace-with-openssl-rand-hex-16
MEILI_MASTER_KEY=replace-with-openssl-rand-hex-32
ADMIN_PANEL_SESSION_SECRET=replace-with-openssl-rand-hex-32

# External ClickHouse/code-interpreter service. Do not expose an untrusted runner publicly.
LIBRECHAT_CODE_BASEURL=https://your-code-interpreter.example.com
LIBRECHAT_CODE_API_KEY=replace-with-code-interpreter-api-key
